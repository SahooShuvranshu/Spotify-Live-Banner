{
  "name": "Spotify Live Banner",
  "description": "A dynamic, real-time Spotify widget for your GitHub profile showing currently playing track with beautiful animations",
  "repository": "https://github.com/SahooShuvranshu/Spotify-Live-Banner",
  "logo": "https://raw.githubusercontent.com/SahooShuvranshu/Spotify-Live-Banner/main/Images/Spotify.svg",
  "keywords": ["spotify", "github", "widget", "music", "python", "flask"],
  "success_url": "/",
  "stack": "container",
  "env": {
    "CLIENT_ID": {
      "description": "Your Spotify App Client ID (optional if using Last.fm)",
      "required": false
    },
    "CLIENT_SECRET": {
      "description": "Your Spotify App Client Secret (optional if using Last.fm)",
      "required": false
    },
    "REFRESH_TOKEN": {
      "description": "Your Spotify Refresh Token (optional if using Last.fm)",
      "required": false
    },
    "LASTFM_API_KEY": {
      "description": "Last.fm API key (get from https://www.last.fm/api/account/create)",
      "required": false
    },
    "LASTFM_USERNAME": {
      "description": "Your Last.fm username",
      "required": false
    },
    "FLASK_ENV": {
      "description": "Flask environment",
      "value": "production",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
